# Evolua — exemplo de ambiente (sem valores reais)
# Copie apenas as variáveis necessárias para o serviço que será executado.
# Nunca versione `.env`. Produção usa secrets do provedor/CI.

## API Fastify (`backend-core/apps/api`)
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://postgres:password@host:6543/postgres?pgbouncer=true&connection_limit=1
# DDL/migrations: conexão direta em :5432, sem `pgbouncer=true`.
DIRECT_URL=postgresql://postgres:password@host:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret
INTERNAL_SERVICE_TOKEN=generate_a_long_random_value
AI_SERVICE_URL=http://localhost:8001
WHATSAPP_SERVICE_URL=http://localhost:8010
FRONTEND_URL=http://localhost:5173
LANDING_URL=http://localhost:5174

## Integrações opcionais da API
HUGGINGFACE_API_KEY=
EVOLUTION_WEBHOOK_SECRET=
SUPABASE_AUTH_HOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=naoresponder@useevolua.com.br
RESEND_FROM_NAME=Evolua
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_NOTIFICATION_EMAIL=
PIX_KEY=
ABACATEPAY_API_KEY=
ABACATEPAY_WEBHOOK_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

## Serviço de IA (`backend-core/apps/ai`)
# Este serviço requer `INTERNAL_SERVICE_TOKEN`, `DATABASE_URL` e `HUGGINGFACE_API_KEY`.
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_CHAT_MODEL=HuggingFaceH4/zephyr-7b-beta
HUGGINGFACE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
HUGGINGFACE_WHISPER_MODEL=openai/whisper-large-v3
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o

## Aplicações Vite
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
VITE_API_URL=http://localhost:3000
VITE_GA_MEASUREMENT_ID=

## Pipeline de conteúdo (scripts/)
# Requer OPENROUTER_API_KEY, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY e RESEND_API_KEY.

# Não use Notifica: a integração foi removida e Resend é o provider atual.
