# ==========================================
# Evolua CRM Backend — Variáveis de Ambiente
# ==========================================
# Copie para .env e preencha. NUNCA commitar o .env real.
# Em produção, configure no secret manager do provider (App Runner / Vercel / Fly).
#
# Para rotacionar tudo, siga docs/CREDENTIAL-ROTATION.md
# Tokens dos MCPs do OpenCode NÃO vão aqui — vão como env do sistema (setx no Windows).

# ==========================================
# Supabase (obrigatório)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Secret usado pela API para verificar JWTs assinados pelo Supabase Auth
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# ==========================================
# Database (obrigatório)
# ==========================================
# Connection pooling (transaction mode) — usado pela aplicação em runtime
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Conexão direta (session mode) — usado APENAS para `prisma migrate`
DIRECT_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ==========================================
# App (obrigatório)
# ==========================================
PORT=8080
NODE_ENV=production
# Lista separada por vírgula
CORS_ORIGINS=https://app.useevolua.com,https://useevolua.com

# ==========================================
# Segurança interna (obrigatório)
# Gerar com: openssl rand -hex 32
# ==========================================
# Token compartilhado entre apps/api e microserviços internos
INTERNAL_API_TOKEN=
# Secret para assinar/verificar tokens JWT internos da app
JWT_SECRET=

# ==========================================
# Hugging Face (opcional — para IA / embeddings)
# ==========================================
HUGGINGFACE_API_KEY=

# ==========================================
# Notifica (e-mails transacionais e notificações in-app)
# ==========================================
NOTIFICA_API_KEY=ntf_live_your_api_key_here
NOTIFICA_FROM_EMAIL=noreply@useevolua.com
# Chave publicável para o SDK React (@notifica/react) — in-app inbox
NOTIFICA_PUBLISHABLE_KEY=

# ==========================================
# Evolution Go (WhatsApp)
# https://docs.evolutionfoundation.com.br/evolution-go
# ==========================================
EVOLUTION_URL=http://localhost:8080
# GLOBAL_API_KEY definida no .env do Evolution Go
EVOLUTION_API_KEY=
# Nome da instância (criada via POST /instance/create)
EVOLUTION_INSTANCE=evolua
# UUID retornado pelo POST /instance/create
EVOLUTION_INSTANCE_ID=
# HMAC-SHA256 secret para validar webhooks (obrigatório em produção)
# Gerar com: openssl rand -hex 32
EVOLUTION_WEBHOOK_SECRET=

# ==========================================
# AbacatePay (billing BR — PIX, Boleto, Cartão, Assinaturas)
# https://docs.abacatepay.com
# ==========================================
# Use a chave v2 (recomendada). Dev: abc_dev_... / Prod: abc_live_...
ABACATEPAY_API_KEY=
# Secret gerado ao criar webhook no painel AbacatePay
ABACATEPAY_WEBHOOK_SECRET=

# ==========================================
# Stripe (billing internacional — cartão fallback)
# https://dashboard.stripe.com/apikeys
# ==========================================
# Use Restricted Key com escopos mínimos (Customers, Subscriptions, Products, Prices, Invoices)
STRIPE_SECRET_KEY=
# Para o frontend (Checkout / Elements)
STRIPE_PUBLISHABLE_KEY=
# Vem do `stripe listen` em dev ou do painel em prod
STRIPE_WEBHOOK_SECRET=

# ==========================================
# Observabilidade
# ==========================================
# Sentry (errors + performance) — recomendado já em dev
# https://sentry.io → Project Settings → Client Keys (DSN)
SENTRY_DSN=
# Auth token para upload de sourcemaps no build
SENTRY_AUTH_TOKEN=
SENTRY_ORG=evolua
SENTRY_PROJECT=evolua-api

# Grafana / Prometheus (opensource self-hosted, opcional)
# Endpoint /metrics da API já expõe formato Prometheus
GRAFANA_URL=
GRAFANA_API_KEY=

# Dynatrace (APM enterprise, opcional — avaliar pós-M2)
DT_OAUTH_CLIENT_ID=
DT_OAUTH_CLIENT_SECRET=
DT_ENVIRONMENT=
