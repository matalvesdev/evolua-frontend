# ==========================================
# Evolua CRM Backend - Variáveis de Ambiente
# ==========================================
# Configure no painel do App Runner (AWS):
# Service > Configuration > Environment variables

# ==========================================
# Supabase (obrigatório)
# ==========================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ==========================================
# Database (obrigatório)
# ==========================================
# Connection pooling (usado pela aplicação)
DATABASE_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# Conexão direta (usado para migrations)
DIRECT_URL=postgresql://postgres.xxx:password@aws-1-sa-east-1.pooler.supabase.com:5432/postgres

# ==========================================
# App (obrigatório)
# ==========================================
PORT=8080
NODE_ENV=production
CORS_ORIGINS=https://your-app.vercel.app

# ==========================================
# Hugging Face (opcional - para IA)
# ==========================================
# HUGGINGFACE_API_KEY=your_key

# ==========================================
# Notifica (emails e notificações)
# ==========================================
NOTIFICA_API_KEY=ntf_live_your_api_key_here
NOTIFICA_FROM_EMAIL=noreply@useevolua.com
# Chave publicável para o SDK React (@notifica/react) — in-app inbox
NOTIFICA_PUBLISHABLE_KEY=

# ==========================================
# Evolution Go (WhatsApp — substitui EVOLUTION_API_*)
# Documentação: https://docs.evolutionfoundation.com.br/evolution-go
# ==========================================
# URL do servidor Evolution Go
EVOLUTION_GO_URL=http://localhost:8080
# GLOBAL_API_KEY definida no .env do Evolution Go
EVOLUTION_GO_API_KEY=sua-chave-segura-aqui
# Nome da instância (definido ao criar via POST /instance/create)
EVOLUTION_GO_INSTANCE=evolua
# UUID gerado automaticamente ao criar a instância
EVOLUTION_GO_INSTANCE_ID=
# Secret para validar assinatura HMAC-SHA256 dos webhooks (recomendado em produção)
EVOLUTION_GO_WEBHOOK_SECRET=

