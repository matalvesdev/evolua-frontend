{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm-install-frontend",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "cwd": "${workspaceFolder}/frontend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "npm-install-backend",
      "type": "shell",
      "command": "npm",
      "args": ["install"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false
      }
    },
    {
      "label": "Frontend Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend-evolua",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*ready.*",
          "endsPattern": "^.*compiled successfully.*"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Backend Dev",
      "type": "shell",
      "command": "npm",
      "args": ["run", "start:dev"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Watching for file changes.*",
          "endsPattern": "^.*$"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Database - Prisma Studio",
      "type": "shell",
      "command": "npm",
      "args": ["run", "prisma:studio"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "isBackground": false,
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      }
    },
    {
      "label": "Database - Migrate",
      "type": "shell",
      "command": "npm",
      "args": ["run", "prisma:migrate"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      }
    },
    {
      "label": "Frontend - Lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "cwd": "${workspaceFolder}/frontend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Frontend - Format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "cwd": "${workspaceFolder}/frontend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Backend - Lint",
      "type": "shell",
      "command": "npm",
      "args": ["run", "lint"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      },
      "problemMatcher": ["$eslint-stylish"]
    },
    {
      "label": "Backend - Format",
      "type": "shell",
      "command": "npm",
      "args": ["run", "format"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    },
    {
      "label": "Test - Frontend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test"],
      "cwd": "${workspaceFolder}/frontend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      }
    },
    {
      "label": "Test - Backend",
      "type": "shell",
      "command": "npm",
      "args": ["run", "test"],
      "cwd": "${workspaceFolder}/backend-evolua/backend-evolua",
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      }
    },
    {
      "label": "Make - Help",
      "type": "shell",
      "command": "make",
      "args": ["help"],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "new"
      }
    }
  ]
}
